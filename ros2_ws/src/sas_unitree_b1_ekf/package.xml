<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_unitree_b1_ekf</name>
  <version>0.0.0</version>
  <description>Basic planar EKF for the Unitree B1. It uses the measured twist of the driver and the Vicon markers.</description>
  <maintainer email="juanjose.quirozomana@manchester.ac.uk">Juan Jose Quiroz Omana</maintainer>
  <license>LGPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>sas_core</depend>
  <depend>sas_common</depend>
  <depend>sas_conversions</depend>
  <depend>sas_robot_driver</depend>
  <depend>sas_tools</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
